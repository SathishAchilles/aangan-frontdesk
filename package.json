{
  "name": "aangan-frontdesk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --dir src",
    "test:contract": "vitest run --dir tests/contract",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "eval": "tsx --env-file-if-exists=.env.local scripts/eval.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts aangan",
    "seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "prebuild": "tsx scripts/check-env.ts",
    "db:migrate:test": "tsx --env-file-if-exists=.env.local scripts/migrate.ts aangan_test",
    "test:coverage": "vitest run --dir src --coverage --coverage.include='src/lib/rules/**' --coverage.exclude='**/*.test.ts' --coverage.thresholds.lines=90",
    "setting:set": "tsx --env-file-if-exists=.env.local scripts/set-setting.ts",
    "telegram:setup": "tsx --env-file-if-exists=.env.local scripts/telegram-setup.ts",
    "staff:add": "tsx --env-file-if-exists=.env.local scripts/add-staff.ts",
    "crm:check": "tsx --env-file-if-exists=.env.local scripts/crm-live-check.ts",
    "staged-call": "tsx --env-file-if-exists=.env.local scripts/staged-call.ts"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "drizzle-orm": "^0.45.4",
    "next": "16.3.6",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
