# Copy to .env.local and fill in. Never commit real values.

# Supabase (hosted project shared with trip-together; app uses its own `aangan` schema)
# Transaction pooler, port 6543, user aangan_app. Used by the app at runtime.
DATABASE_URL=
# Session pooler, port 5432. Used only by drizzle-kit migrations and scripts.
DATABASE_MIGRATION_URL=
# Project URL and publishable key, used for dashboard login (Supabase Auth).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Postgres schema the app reads and writes. Tests set this to aangan_test.
DB_SCHEMA=aangan

# Shared secret Vaani sends in the X-Tool-Key header on mid-call tool requests.
TOOL_SECRET=

# Vaani voice agent (vaanivoice.ai). API key starts with vaani_.
VAANI_API_KEY=
VAANI_AGENT_ID=
# Token appended to the Vaani webhook URL (?token=...). Vaani does not sign webhooks.
VAANI_WEBHOOK_TOKEN=
# Front-desk phone that receives transferred calls, E.164.
FRONT_DESK_PHONE=

# Gemini: post-call note and eval judge.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_JUDGE_MODEL=gemini-2.5-pro

# Cal.com booking.
CALCOM_API_KEY=
CALCOM_WEBHOOK_SECRET=

# Telegram bot for staff (designers, front desk, founder). Never messages callers.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# HubSpot private/static app access token.
HUBSPOT_PRIVATE_APP_TOKEN=

# Bearer secret pg_cron sends to /api/cron/followups.
CRON_SECRET=

# Public base URL of this app, no trailing slash.
APP_URL=https://aangan-frontdesk.vercel.app

# Maximum Gemini spend per eval run, in rupees.
EVAL_BUDGET_INR=300
